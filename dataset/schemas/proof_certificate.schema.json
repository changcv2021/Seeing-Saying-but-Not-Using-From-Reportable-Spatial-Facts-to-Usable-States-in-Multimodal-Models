{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceconflict.local/schemas/proof_certificate.schema.json",
  "type": "object",
  "required": ["certificate_id", "label", "level", "conflict_slots", "proof_nodes", "proof_edges", "evidence_fact_ids", "co_truth_possible", "requires_unprovided_fact", "minimality"],
  "properties": {
    "certificate_id": {"type": "string"},
    "label": {"enum": ["SUPPORTED", "CONTRADICTORY", "UNKNOWN"]},
    "level": {"type": ["string", "null"], "enum": ["L1", "L2", "L3", "L4", null]},
    "conflict_slots": {"type": "array", "items": {"type": "string"}},
    "proof_nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["SOURCE_FACT", "OBSERVATION", "IDENTITY_LINK", "REFERENCE_TRANSFORM", "INTERVENTION", "RULE", "DERIVED_FACT", "CLAIM_ATOM", "CONTRADICTION", "CORRECTION"]}
        }
      }
    },
    "proof_edges": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [{"type": "string"}, {"type": "string"}, {"type": "string"}],
        "items": false
      }
    },
    "evidence_fact_ids": {"type": "array", "items": {"type": "string"}},
    "co_truth_possible": {"const": false},
    "requires_unprovided_fact": {"const": false},
    "minimality": {
      "type": "object",
      "required": ["is_minimal", "ablation_results"],
      "properties": {
        "is_minimal": {"const": true},
        "ablation_results": {
          "type": "array",
          "items": {"type": "object", "required": ["removed_fact_id", "result"]}
        }
      }
    }
  },
  "additionalProperties": true
}
