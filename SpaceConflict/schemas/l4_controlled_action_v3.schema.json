{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceconflict.local/schemas/l4_controlled_action_v3.schema.json",
  "type": "object",
  "required": [
    "action_id", "family", "parameters", "preconditions", "delete_fact_slots",
    "add_facts", "allowed_post_fact_slots", "count_deltas", "identity_deltas",
    "allowed_claim_templates", "forbidden_inferences", "model_visible_text",
    "provenance", "version"
  ],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "family": {"enum": ["REMOVE_AND_RECOUNT", "ADD_AND_RECOUNT", "REPLACE_AND_RECOUNT", "REPLACEMENT_IDENTITY", "MOVE_TO_OPPOSITE_SIDE", "SWAP_POSITIONS"]},
    "parameters": {"type": "object"},
    "preconditions": {"type": "array", "minItems": 1},
    "delete_fact_slots": {"type": "array", "minItems": 1},
    "add_facts": {"type": "array", "minItems": 1},
    "allowed_post_fact_slots": {"type": "array", "minItems": 1},
    "count_deltas": {"type": "object"},
    "identity_deltas": {"type": "object"},
    "allowed_claim_templates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_inferences": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "model_visible_text": {"type": "string", "minLength": 1},
    "provenance": {"const": "SPACECONFLICT_CONTROLLED_DSL"},
    "version": {"const": "controlled_dsl_v1"}
  }
}
